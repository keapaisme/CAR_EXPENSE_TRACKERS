<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>愛車支出記帳系統分析 - 雙語漫畫風演示稿</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@500;900&family=Impact&display=swap" rel="stylesheet">
    <!-- GSAP -->
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      :root {
        --manga-red: #ff3b30;
        --manga-black: #000000;
        --manga-white: #ffffff;
      }
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html, body {
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        background: var(--manga-black);
        font-family: 'Noto Sans TC', sans-serif;
      }
      
      /* 畫布外框，用於固定 1920x1080 解析度，並藉由 JS resize 等比例縮放 */
      #root {
        position: absolute;
        top: 0;
        left: 0;
        width: 1920px;
        height: 1080px;
        border: 12px solid var(--manga-white);
        overflow: hidden;
        background: var(--manga-black);
      }

      /* 漫畫背景網點效果 */
      .manga-grid-bg {
        position: absolute;
        width: 100%;
        height: 100%;
        background-color: var(--manga-black);
        background-image: radial-gradient(var(--manga-white) 15%, transparent 16%);
        background-size: 16px 16px;
        opacity: 0.08;
        pointer-events: none;
        z-index: 1;
      }

      /* 幻燈片容器 */
      .slide {
        position: absolute;
        width: 100%;
        height: 100%;
        display: grid;
        grid-template-columns: 1fr 1fr;
        padding: 60px;
        gap: 40px;
        opacity: 0;
        visibility: hidden;
        z-index: 2;
      }

      /* 滿版幻燈片容器 (用於 Slide 2 & 3 母子屏) */
      .slide-full {
        position: absolute;
        width: 100%;
        height: 100%;
        display: block; /* 滿版 */
        padding: 60px;
        opacity: 0;
        visibility: hidden;
        z-index: 2;
      }

      /* 漫畫分鏡框 */
      .panel {
        border: 8px solid var(--manga-white);
        background: var(--manga-black);
        position: relative;
        overflow: hidden;
        box-shadow: 12px 12px 0px var(--manga-red);
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
      }
      .panel-content {
        padding: 40px;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      /* 視覺插圖 */
      .manga-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border: 4px solid var(--manga-black);
      }

      /* 裝飾斜角條與速度線 */
      .action-badge {
        position: absolute;
        top: 20px;
        left: -10px;
        background: var(--manga-red);
        color: var(--manga-white);
        font-family: 'Impact', sans-serif;
        font-weight: 900;
        font-size: 32px;
        padding: 10px 30px;
        transform: rotate(-3deg);
        border: 4px solid var(--manga-white);
        box-shadow: 4px 4px 0px var(--manga-black);
        z-index: 5;
        letter-spacing: 2px;
      }

      /* 大標題 */
      .manga-title {
        font-size: 72px;
        font-weight: 900;
        color: var(--manga-white);
        text-shadow: 4px 4px 0px var(--manga-red), -2px -2px 0px var(--manga-black), 2px -2px 0px var(--manga-black), -2px 2px 0px var(--manga-black), 2px 2px 0px var(--manga-black);
        margin-bottom: 30px;
        line-height: 1.2;
        letter-spacing: 2px;
      }

      /* 亮點卡片 */
      .manga-card {
        background: var(--manga-white);
        color: var(--manga-black);
        padding: 24px;
        border: 5px solid var(--manga-black);
        border-radius: 4px;
        margin-bottom: 20px;
        position: relative;
        transform: rotate(0.5deg);
      }
      .manga-card::before {
        content: '';
        position: absolute;
        top: 5px;
        left: 5px;
        right: -10px;
        bottom: -10px;
        background: var(--manga-red);
        z-index: -1;
        border: 4px solid var(--manga-black);
      }
      .manga-card-title {
        font-size: 28px;
        font-weight: 900;
        margin-bottom: 8px;
        color: var(--manga-red);
        text-shadow: 1px 1px 0px var(--manga-black);
      }
      .manga-card-text {
        font-size: 20px;
        font-weight: 500;
        line-height: 1.4;
      }

      /* 右側手機嵌入區域 (母子屏懸浮) */
      .phone-container-pip {
        position: absolute;
        right: 80px;
        bottom: 120px;
        width: 320px;
        height: 600px;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .iphone-frame-pip {
        width: 290px;
        height: 580px;
        border: 10px solid #1a1a1a;
        border-radius: 38px;
        background: #000;
        overflow: hidden;
        position: relative;
        box-shadow: 0px 20px 45px rgba(0, 0, 0, 0.9), 0 0 0 4px var(--manga-white);
      }
      /* 手機普通排版容器 (專案介紹時備用) */
      .phone-container-standard {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(circle, var(--manga-red) 10%, transparent 11%);
        background-size: 24px 24px;
        border: 8px solid var(--manga-white);
        box-shadow: 12px 12px 0px var(--manga-red);
        position: relative;
      }
      .iphone-frame-standard {
        width: 400px;
        height: 820px;
        border: 12px solid #1a1a1a;
        border-radius: 48px;
        background: #000;
        overflow: hidden;
        position: relative;
        box-shadow: 0px 25px 50px -12px rgba(0, 0, 0, 0.8), 0 0 0 4px var(--manga-white);
      }

      /* 動態島 */
      .iphone-island {
        position: absolute;
        top: 10px;
        left: 50%;
        transform: translateX(-50%);
        width: 80px;
        height: 20px;
        background: #000;
        border-radius: 20px;
        z-index: 10;
        border: 1px solid #333;
      }
      .phone-iframe {
        width: 100%;
        height: 100%;
        border: none;
        background: #000;
      }

      /* 底部字幕融入條 (疊加在畫面上) */
      .subtitle-container {
        position: absolute;
        bottom: 50px;
        left: 50%;
        transform: translateX(-50%);
        width: 1300px;
        min-height: 90px;
        background: rgba(0, 0, 0, 0.85); /* 半透明黑 */
        border: 4px solid var(--manga-white); /* 白色描邊 */
        border-radius: 12px;
        padding: 15px 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 8px 8px 0px var(--manga-red); /* 紅色陰影 */
        z-index: 100;
      }
      .subtitle-text {
        color: var(--manga-white);
        font-size: 30px;
        font-weight: 900;
        text-align: center;
        line-height: 1.4;
        letter-spacing: 1px;
        text-shadow: 2px 2px 0px var(--manga-black);
      }

      /* 播放指示控制條 */
      .preview-controls {
        position: absolute;
        top: 20px;
        right: 20px;
        background: rgba(0, 0, 0, 0.9);
        border: 3px solid var(--manga-white);
        padding: 10px 20px;
        z-index: 999;
        display: flex;
        gap: 15px;
        align-items: center;
        font-size: 14px;
        font-family: monospace;
      }
      .btn-play {
        background: var(--manga-red);
        color: var(--manga-white);
        border: 2px solid var(--manga-white);
        padding: 5px 12px;
        cursor: pointer;
        font-weight: bold;
      }
      .btn-lang {
        background: var(--manga-white);
        color: var(--manga-black);
        border: 2px solid var(--manga-red);
        padding: 5px 12px;
        cursor: pointer;
        font-weight: bold;
      }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="102.1" data-width="1920" data-height="1080">
      <div class="manga-grid-bg"></div>

      <!-- 🔊 中文語音音軌 -->
      <audio id="audio1" src="assets/slide1.wav" preload="auto" data-start="0" data-duration="20.2"></audio>
      <audio id="audio2" src="assets/slide2.wav" preload="auto" data-start="20.2" data-duration="19.8"></audio>
      <audio id="audio3" src="assets/slide3.wav" preload="auto" data-start="40.0" data-duration="30.9"></audio>
      <audio id="audio4" src="assets/slide4.wav" preload="auto" data-start="70.9" data-duration="31.2"></audio>

      <!-- 🔊 日文語音音軌 -->
      <audio id="audio1_ja" src="assets/slide1_ja.wav" preload="auto" data-start="0" data-duration="20.2"></audio>
      <audio id="audio2_ja" src="assets/slide2_ja.wav" preload="auto" data-start="20.2" data-duration="19.8"></audio>
      <audio id="audio3_ja" src="assets/slide3_ja.wav" preload="auto" data-start="40.0" data-duration="30.9"></audio>
      <audio id="audio4_ja" src="assets/slide4_ja.wav" preload="auto" data-start="70.9" data-duration="31.2"></audio>

      <!-- 🎮 簡報控制 (本機預覽與語言切換) -->
      <div class="preview-controls">
        <span>TIME: <span id="time-display">0.00</span>s</span>
        <button class="btn-lang" id="btn-lang" onclick="toggleLanguage()">LANG: ZH (中文)</button>
        <button class="btn-play" onclick="togglePlay()">PLAY/PAUSE</button>
      </div>

      <!-- 💬 融入式字幕框 -->
      <div class="subtitle-container">
        <div class="subtitle-text" id="subtitle-box">載入中...</div>
      </div>

      <!-- ==================== SLIDE 1: 專案介紹 (左右半分鏡) ==================== -->
      <div class="slide" id="slide1">
        <div class="panel">
          <div class="action-badge">INTRO</div>
          <img class="manga-img" src="assets/slide1.jpg" alt="Slide 1 Illustration">
        </div>
        <div class="panel-content">
          <h1 class="manga-title">愛車支出記帳<br>小程式！</h1>
          <div class="manga-card">
            <div class="manga-card-title">🚗 愛車專屬輕量記帳</div>
            <div class="manga-card-text">為愛車花費量身打造的輕量化、純前端網頁。省去繁瑣設定，開啟即用！</div>
          </div>
          <div class="manga-card">
            <div class="manga-card-title">💡 告別繁瑣痛點</div>
            <div class="manga-card-text">拒絕市面上廣告多、功能複雜的記帳 App，重回純粹用車體驗。</div>
          </div>
        </div>
      </div>

      <!-- ==================== SLIDE 2: 視覺設計 (滿版漫畫 + 右下母子屏) ==================== -->
      <div class="slide-full" id="slide2">
        <div class="panel">
          <div class="action-badge">DESIGN</div>
          <img class="manga-img" src="assets/slide2.jpg" alt="Slide 2 Illustration">
        </div>
        <!-- 母子屏手機子展 -->
        <div class="phone-container-pip" id="phoneContainerPip">
          <div class="iphone-frame-pip" id="iphoneFramePip">
            <div class="iphone-island"></div>
            <iframe class="phone-iframe" id="appFrame" src="app.html"></iframe>
          </div>
        </div>
      </div>

      <!-- ==================== SLIDE 3: 功能展示 (滿版漫畫 + 右下母子屏) ==================== -->
      <div class="slide-full" id="slide3">
        <div class="panel">
          <div class="action-badge">FEATURES</div>
          <img class="manga-img" src="assets/slide3.jpg" alt="Slide 3 Odometer Illustration">
        </div>
        <!-- 簡報播放到 slide3 時，手機 iframe 容器會被動態移到這裡 -->
        <div class="phone-container-pip" id="phoneContainerPip3"></div>
      </div>

      <!-- ==================== SLIDE 4: 技術架構 (左右半分鏡) ==================== -->
      <div class="slide" id="slide4">
        <div class="panel">
          <div class="action-badge">SECURITY</div>
          <img class="manga-img" src="assets/slide4.jpg" alt="Slide 4 Security Illustration">
        </div>
        <div class="panel-content">
          <h1 class="manga-title">安全直連架構</h1>
          <div class="manga-card">
            <div class="manga-card-title">🔒 零後端隱私安全</div>
            <div class="manga-card-text">純前端網頁透過 GAS 直連您的個人 Google Sheets 試算表，數據自己完全掌控！</div>
          </div>
          <div class="manga-card">
            <div class="manga-card-title">⚡ 一鍵資料備份</div>
            <div class="manga-card-text">支援一鍵導出帶有 UTF-8 BOM 的 CSV 檔案，用 Windows Excel 開啟也絕不亂碼！</div>
          </div>
        </div>
      </div>
    </div>

    <script>
      // ==================== 1. 視窗自適應等比例縮放 (16:9 YouTube) ====================
      function resizePresentation() {
        const root = document.getElementById('root');
        const scale = Math.min(window.innerWidth / 1920, window.innerHeight / 1080);
        root.style.transform = `scale(${scale})`;
        root.style.transformOrigin = 'top left';
        // 置中 Canvas
        const leftOffset = (window.innerWidth - 1920 * scale) / 2;
        const topOffset = (window.innerHeight - 1080 * scale) / 2;
        root.style.left = leftOffset + 'px';
        root.style.top = topOffset + 'px';
        
        document.body.style.width = window.innerWidth + 'px';
        document.body.style.height = window.innerHeight + 'px';
      }
      window.addEventListener('resize', resizePresentation);
      window.addEventListener('load', resizePresentation);

      // ==================== 2. 字幕數據與時間軸設定 ====================
      // 中文字幕
      const subtitlesZh = [
        { time: 0.0, text: "因為愛她，所以養她。" },
        { time: 2.5, text: "但又不曉得錢都花哪去，最好的辦法就是記帳——" },
        { time: 5.5, text: "『愛車支出記帳小程序』！" },
        { time: 8.5, text: "這是一個專門為車主量身打造的輕量化記帳工具，" },
        { time: 13.0, text: "讓你輕鬆掌握愛車的每一筆花費，告別繁瑣，" },
        { time: 17.0, text: "重回駕駛的純粹樂趣。" },

        { time: 20.2, text: "在視覺上，就是極簡。" },
        { time: 22.5, text: "純黑背景搭配深灰卡片，並用細緻的金色作為點綴。" },
        { time: 27.0, text: "去除了生硬的框線，以呼吸感的排版和大圓角展現出高雅質感。" },
        { time: 32.0, text: "每一次記帳成功，還會彈出類似 Apple Pay 的動態打勾回饋，" },
        { time: 36.5, text: "讓記帳也充滿儀式感。" },

        { time: 40.0, text: "除了美觀，功能更是為車主量身定制。" },
        { time: 43.5, text: "系統內建了里程數記憶功能，" },
        { time: 47.5, text: "自動解析備註中的里程，並幫你算出每公里的平均油資。" },
        { time: 52.5, text: "我們還提供了金額與常用備註的快捷鍵，" },
        { time: 58.0, text: "一鍵輸入『九五加滿』或『定期保養』。" },
        { time: 62.0, text: "配合每月的預算進度條，當開銷接近警戒線時，" },
        { time: 66.5, text: "系統會自動亮起紅燈，讓你的荷包不再超支。" },

        { time: 70.9, text: "這款小程式最大的特點在於其無後端架構。" },
        { time: 75.0, text: "我們使用純前端 HTML，直接透過 Google Apps Script 連接你個人的 Google 試算表。" },
        { time: 81.0, text: "這意味著所有數據都牢牢掌握在你自己手中，" },
        { time: 87.0, text: "沒有任何第三方伺服器會洩漏你的隱私。" },
        { time: 92.5, text: "這是一個完全安全、自主，" },
        { time: 98.0, text: "且可以隨時 CSV 一鍵匯出的終極養車記帳方案！" }
      ];

      // 日文字幕
      const subtitlesJa = [
        { time: 0.0, text: "車の維持費は底なし沼のように感じられませんか？" },
        { time: 2.5, text: "市販の家計簿アプリは広告だらけで複雑すぎます。" },
        { time: 5.5, text: "そこで、軽量な『愛車支出記録システム』を開発しました。" },
        { time: 8.5, text: "これはドライバーのために特別設計された記帳ツールです。" },
        { time: 13.0, text: "支出を簡単に管理し、" },
        { time: 17.0, text: "運転の純粋な楽しさに戻りましょう。" },

        { time: 20.2, text: "ビジュアルは極簡そのものです。" },
        { time: 22.5, text: "アイオーエスダークモード風を採用し、漆黒の背景に深灰カード、ゴールドのアクセントを施しました。" },
        { time: 27.0, text: "呼吸感のあるレイアウトと大きな角丸で上品な質感を表現。" },
        { time: 32.0, text: "記帳成功時にはアップルペイ風のチェックアニメーションが飛び出し、" },
        { time: 36.5, text: "記帳に儀式感をもたらします。" },

        { time: 40.0, text: "機能もドライバー向けにカスタマイズされています。" },
        { time: 43.5, text: "走行距離の記憶機能を内蔵し、" },
        { time: 47.5, text: "備考から距離を自動解析して一キロあたりの平均燃料費を算出します。" },
        { time: 52.5, text: "さらに、金額や備考のショートカットも用意。" },
        { time: 58.0, text: "月間予算の管理により、" },
        { time: 62.0, text: "支出が制限に近づくと、赤い警告ランプが点灯し、" },
        { time: 66.5, text: "予算オーバーを防ぎます。" },

        { time: 70.9, text: "このアプリ最大の特徴はサーバーレスな個人直結アーキテクチャです。" },
        { time: 75.0, text: "純エイチティーエムエルを使用し、ジーエーエスを介して個人のグーグルスプレッドシートに直接接続します。" },
        { time: 81.0, text: "すべてのデータはあなたの手元にしっかりと残り、" },
        { time: 87.0, text: "サードパーティに漏洩しません。" },
        { time: 92.5, text: "完全な安全と自律、" },
        { time: 98.0, text: "いつでもシーエスブイエクスポートが可能な究極の家計簿です。" }
      ];

      // ==================== 3. GSAP 主時間軸與幻燈片切換 ====================
      window.__timelines = window.__timelines || {};
      const tl = gsap.timeline({
        paused: true,
        onUpdate: onTimelineUpdate
      });

      tl.to({}, { duration: 102.1 });

      // Slide 1 Show
      tl.set("#slide1", { display: "grid", visibility: "visible", opacity: 1 }, 0);
      tl.to("#slide1", { opacity: 0, duration: 0.5 }, 19.7);
      tl.set("#slide1", { display: "none", visibility: "hidden" }, 20.2);

      // Slide 2 Show
      tl.set("#slide2", { display: "block", visibility: "visible", opacity: 0 }, 20.2);
      tl.to("#slide2", { opacity: 1, duration: 0.5 }, 20.2);
      tl.to("#slide2", { opacity: 0, duration: 0.5 }, 39.5);
      tl.set("#slide2", { display: "none", visibility: "hidden" }, 40.0);

      // Slide 3 Show
      tl.set("#slide3", { display: "block", visibility: "visible", opacity: 0 }, 40.0);
      tl.to("#slide3", { opacity: 1, duration: 0.5 }, 40.0);
      tl.to("#slide3", { opacity: 0, duration: 0.5 }, 70.4);
      tl.set("#slide3", { display: "none", visibility: "hidden" }, 70.9);

      // Slide 4 Show
      tl.set("#slide4", { display: "grid", visibility: "visible", opacity: 0 }, 70.9);
      tl.to("#slide4", { opacity: 1, duration: 0.5 }, 70.9);

      window.__timelines["main"] = tl;

      // ==================== 4. 中日雙語音效與切換控制 ====================
      let currentLanguage = 'zh'; // 預設中文

      const audiosZh = [
        { el: document.getElementById('audio1'), start: 0, end: 20.2 },
        { el: document.getElementById('audio2'), start: 20.2, end: 40.0 },
        { el: document.getElementById('audio3'), start: 40.0, end: 70.9 },
        { el: document.getElementById('audio4'), start: 70.9, end: 102.1 }
      ];

      const audiosJa = [
        { el: document.getElementById('audio1_ja'), start: 0, end: 20.2 },
        { el: document.getElementById('audio2_ja'), start: 20.2, end: 40.0 },
        { el: document.getElementById('audio3_ja'), start: 40.0, end: 70.9 },
        { el: document.getElementById('audio4_ja'), start: 70.9, end: 102.1 }
      ];

      function toggleLanguage() {
        // 先暫停當前所有音軌
        audiosZh.forEach(audio => audio.el.pause());
        audiosJa.forEach(audio => audio.el.pause());

        // 切換語言
        currentLanguage = currentLanguage === 'zh' ? 'ja' : 'zh';
        
        // 更新 UI
        const btn = document.getElementById('btn-lang');
        if (currentLanguage === 'zh') {
          btn.textContent = "LANG: ZH (中文)";
          btn.style.background = "#ffffff";
          btn.style.color = "#000000";
        } else {
          btn.textContent = "LANG: JA (日本語)";
          btn.style.background = "#ff3b30";
          btn.style.color = "#ffffff";
        }

        // 即時同步一次
        onTimelineUpdate();
      }

      function onTimelineUpdate() {
        const time = tl.time();
        document.getElementById('time-display').textContent = time.toFixed(2);

        // A. 同步當前語言音軌
        syncAudioTrack(time);

        // B. 同步當前語言字幕
        syncSubtitles(time);

        // C. 動態操作 iframe
        syncIFrameDemo(time);
      }

      function syncAudioTrack(time) {
        const activeAudios = currentLanguage === 'zh' ? audiosZh : audiosJa;
        const inactiveAudios = currentLanguage === 'zh' ? audiosJa : audiosZh;

        // 停止非活動語系的所有音軌
        inactiveAudios.forEach(audio => {
          if (!audio.el.paused) {
            audio.el.pause();
            audio.el.currentTime = 0;
          }
        });

        // 找到當前應該播放的活動音軌
        let activeIndex = -1;
        for (let i = 0; i < activeAudios.length; i++) {
          if (time >= activeAudios[i].start && time < activeAudios[i].end) {
            activeIndex = i;
            break;
          }
        }

        activeAudios.forEach((audio, index) => {
          if (index === activeIndex) {
            const offset = time - audio.start;
            if (!tl.paused()) {
              if (audio.el.paused) {
                audio.el.play().catch(() => {});
              }
              if (Math.abs(audio.el.currentTime - offset) > 0.3) {
                audio.el.currentTime = offset;
              }
            } else {
              audio.el.pause();
              audio.el.currentTime = offset;
            }
          } else {
            if (!audio.el.paused) {
              audio.el.pause();
              audio.el.currentTime = 0;
            }
          }
        });
      }

      function syncSubtitles(time) {
        const activeList = currentLanguage === 'zh' ? subtitlesZh : subtitlesJa;
        let activeText = "";
        for (let i = activeList.length - 1; i >= 0; i--) {
          if (time >= activeList[i].time) {
            activeText = activeList[i].text;
            break;
          }
        }
        document.getElementById('subtitle-box').textContent = activeText;
      }

      // ==================== 5. 網頁 iframe 自動化操作演示 ====================
      const iframe = document.getElementById('appFrame');

      // 簡報時間到 40 秒時，將手機 iframe 容器從 slide2 移動到 slide3 中
      tl.call(() => {
        const frame = document.getElementById('iphoneFramePip');
        const container3 = document.getElementById('phoneContainerPip3');
        if (frame && container3) {
          container3.appendChild(frame);
        }
      }, null, 40.0);

      tl.call(() => {
        // 時刻 20.2: 退回 slide2 時把 iframe 移回去
        const frame = document.getElementById('appFrame');
        const container2 = document.querySelector('#slide2 .phone-container .iphone-frame');
        if (frame && container2) {
          container2.appendChild(frame);
        }
      }, null, 20.2);

      function syncIFrameDemo(time) {
        try {
          const iframeWin = iframe.contentWindow;
          if (iframeWin) {
            iframeWin.postMessage({ action: 'syncTime', time: time }, '*');
          }
        } catch (e) {
          console.warn("IFrame postMessage error:", e);
        }
      }

      // ==================== 5. 播放控制 (預覽用) ====================
      function togglePlay() {
        if (tl.paused()) {
          // 先啟動所有音軌的 context 避免瀏覽器擋音訊
          audios.forEach(audio => {
            audio.el.play().then(() => audio.el.pause()).catch(()=>{});
          });
          tl.play();
        } else {
          tl.pause();
          audios.forEach(audio => audio.el.pause());
        }
      }

      // 點擊背景任何地方也能 toggle
      document.body.addEventListener('click', (e) => {
        if (e.target.tagName !== 'BUTTON' && e.target.tagName !== 'INPUT' && e.target.tagName !== 'IFRAME') {
          togglePlay();
        }
      });
    </script>
  </body>
</html>
